{"code":"OK","data":[{"name":"otel-demo","tools":[{"name":"get_trace","description":"查看一条调用链的树形摘要；缺失父节点会明确标记。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{"trace_id":{"type":"string","description":"十六或三十二位小写十六进制 trace ID","minLength":16,"maxLength":32,"pattern":"^(?:[0-9a-f]{16}|[0-9a-f]{32})$"}},"required":["trace_id"],"additionalProperties":false}},{"name":"kafka_consumer_lag","description":"通过指标查看消费者积压，不直接连接 Kafka 管理接口。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false}},{"name":"list_firing_alerts","description":"查看当前正式触发的告警；观察中的 pending 不在这里。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false}},{"name":"query_metrics","description":"执行 PromQL。最多一小时、二十条序列、每条二百四十一个点；返回摘要。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{"lookback_seconds":{"type":"integer","description":"回看秒数；0 表示即时查询","maximum":3600,"default":300},"query":{"type":"string","description":"PromQL 表达式，只在当前绑定的监控后端执行","minLength":1,"maxLength":2048},"step_seconds":{"type":"integer","description":"范围查询采样间隔，单位秒","minimum":1,"maximum":300,"default":15}},"required":["query"],"additionalProperties":false}},{"name":"recent_changes","description":"查看近期启动时间和版本标签。采样首次出现的时间不等于精确发布时间。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{"lookback_seconds":{"type":"integer","description":"回看秒数","minimum":60,"maximum":3600,"default":900}},"required":[],"additionalProperties":false}},{"name":"search_logs","description":"按服务、级别、关键词和时间搜索日志。关键词按普通文字处理，不接受 LogQL。","read_only":true,"timeout_seconds":10,"parameters":{"type":"object","properties":{"keyword":{"type":"string","description":"可选普通文字关键词","maxLength":256},"level":{"type":"string","description":"可选日志级别","maxLength":5,"enum":["DEBUG","INFO","WARN","ERROR"]},"limit":{"type":"integer","description":"最多日志条数","mini