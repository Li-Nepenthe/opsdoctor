# 全部密码都是本机演示假值，不可用于线上；复制为 .env，真实值只存在忽略的文件或环境变量中。
# 从根目录运行 Compose 时加 --env-file .env；Go 程序不会自动加载该文件。
MYSQL_ROOT_PASSWORD=demo-root-only-change-me
MYSQL_PASSWORD=demo-app-only-change-me

# 库存服务与 shopctl 的宿主机连接配置；容器内的地址在 Compose 中组装。
MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/shop?parseTime=true
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# 显式设置才会运行集成测试；迁移测试仅允许 opsdoctor_migrate_test 这个专用库。
TEST_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_mysql_test?parseTime=true
TEST_MIGRATE_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_migrate_test?parseTime=true
TEST_INVENTORY_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_inventory_test?parseTime=true
TEST_SEED_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_seed_test?parseTime=true
TEST_ORDER_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_order_test?parseTime=true
TEST_SALES_MYSQL_DSN=app:demo-app-only-change-me@tcp(127.0.0.1:3306)/opsdoctor_sales_test?parseTime=true
# 商品测试固定用 Redis DB 14，幂等测试固定用 DB 15；都只清理自己创建的 key。
TEST_REDIS_ADDR=127.0.0.1:6379
TEST_REDIS_PASSWORD=demo-business-redis-only
# 医生只读权限的额外集成测试；业务缓存测试仍只使用上面的八个变量。
TEST_SHOP_REDIS_RO_URL=redis://diag_ro:demo-doctor-redis-only@127.0.0.1:6379/0

# 阶段 1 实际使用的地址；库存的管理端口是 6062，不与未来订单服务的 6061 混用。
GRPC_ADDR=:9001
ADMIN_ADDR=:6062
INVENTORY_GRPC_TARGET=127.0.0.1:9001

# 阶段 2 的订单与消息配置。宿主机运行订单服务时，ADMIN_ADDR 应改为 :6061；worker 用 :6063。
HTTP_ADDR=:8081
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=demo-business-redis-only
# 医生与业务必须使用不同密码；医生容器不接收上面的业务密码。
SHOP_REDIS_RO_PASSWORD=demo-doctor-redis-only
KAFKA_BROKERS=127.0.0.1:9092
HTTP_REQUEST_TIMEOUT=3s
ORDER_CLEANUP_TIMEOUT=2s
# 已提交订单等待 Kafka 确认的独立预算；大于 Kafka 单次三秒写入预算。
ORDER_PUBLISH_TIMEOUT=5s
INVENTORY_CALL_TIMEOUT=800ms
# 无 RPC 时多久后回收 gRPC 连接；默认 30m，0s 关闭回收，排障实验可临时用 10s。
INVENTORY_GRPC_IDLE_TIMEOUT=30m
INVENTORY_GETSTOCK_MAX_RETRIES=2
# 单次查询可以比总预算短；0s 保持所有尝试共享总截止时间，扣减不使用此配置。
INVENTORY_GETSTOCK_ATTEMPT_TIMEOUT=0s

# 宿主机实验控制；真实密码仅放本机环境中，下面只是演示值。
ORDER_IMAGE=opsdoctor/order-service:20261026.1
INVENTORY_IMAGE=opsdoctor/inventory-service:20261026.1
ORDER_GO_TAGS=
CHAOS_MYSQL_PASSWORD=demo-only-chaos-password
CHAOS_MYSQL_DSN=chaos:demo-only-chaos-password@tcp(127.0.0.1:3306)/shop?parseTime=true
CHAOS_REDIS_ADDR=127.0.0.1:6379
TOXIPROXY_URL=http://127.0.0.1:8474
LOADGEN_CONTROL_URL=http://127.0.0.1:6070
PROMETHEUS_URL=http://127.0.0.1:9090
INVENTORY_RETRY_BACKOFF=50ms
INVENTORY_RETRY_MIN_BUDGET=50ms
INVENTORY_BREAKER_ENABLED=true
INVENTORY_BREAKER_MIN_REQUESTS=10
INVENTORY_BREAKER_FAILURE_PERCENT=50
INVENTORY_BREAKER_INTERVAL=10s
INVENTORY_BREAKER_OPEN_TIMEOUT=5s
INVENTORY_BREAKER_HALF_OPEN_MAX=1
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=100
CACHE_SINGLEFLIGHT=true
CACHE_TTL_JITTER=60s
IDEMPOTENCY_TTL=24h
WORKER_MESSAGE_TIMEOUT=10s

# 压测默认持续运行。首次空库准备或暂时学习时，把 QPS 设为 0；small 造数把商品数设为 100。
LOADGEN_TARGET=http://127.0.0.1:8081
LOADGEN_ADDR=:6070
LOADGEN_QPS=200
LOADGEN_PRODUCT_COUNT=500000
LOADGEN_WORKERS=64
# chaos 验收比较的是控制接口的活跃参数；自定义实验需同时修改这两个预期值。
CHAOS_BASELINE_PRODUCT_COUNT=10000
CHAOS_BASELINE_WORKERS=64
LOADGEN_REQUEST_TIMEOUT=3s
LOADGEN_DURATION=0s

# 医生接入与登录：DSN 中的密码要与上方或相邻账号密码同步。
# SHOP_* 使用容器地址；TEST_SHOP_* 使用宿主机地址。
DOCTOR_MYSQL_ROOT_PASSWORD=demo-doctor-root-only
DOCTOR_MYSQL_PASSWORD=demo-doctor-db-only
DOCTOR_MYSQL_DSN=doctor:demo-doctor-db-only@tcp(127.0.0.1:3307)/doctor?parseTime=true
TEST_DOCTOR_MYSQL_DSN=doctor:demo-doctor-db-only@tcp(127.0.0.1:3307)/opsdoctor_doctor_test?parseTime=true
DOCTOR_ADMIN_EMAIL=learner@opsdoctor.local
DOCTOR_ADMIN_PASSWORD=demo-doctor-login-only
DOCTOR_ADDR=:8090
DOCTOR_URL=http://127.0.0.1:8090
# 登录后把 token 只放在本终端环境，不要写进命令参数或提交。
DOCTOR_TOKEN=
JWT_SECRET=demo-jwt-secret-at-least-32-bytes-not-for-real-use
SHOP_ALERT_TOKEN=demo-alert-token-not-for-real-use
TARGETS_DIR=deploy/doctor/targets
SHOP_MYSQL_RO_PASSWORD=demo-doctor-mysql-only
TEST_SHOP_MYSQL_RO_DSN=diag_ro:demo-doctor-mysql-only@tcp(127.0.0.1:3306)/shop?parseTime=true
SHOP_MYSQL_RO_DSN=diag_ro:demo-doctor-mysql-only@tcp(shop-mysql:3306)/shop?parseTime=true
SHOP_REDIS_RO_URL=redis://diag_ro:demo-doctor-redis-only@redis:6379/0
# 阶段 6、7 预留，本阶段不读取，不填写付费模型密钥。
OPS_TOKEN=demo-ops-token-not-for-real-use
SHOP_MYSQL_DDL_DSN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60s
LLM_INPUT_PRICE_PER_MTOKEN=
LLM_OUTPUT_PRICE_PER_MTOKEN=
DOCTOR_MAX_CONCURRENT=2
EVAL_TOKEN_BUDGET=

# 阶段 3：这些值仅用于演示。公开仓库不能填写真实的管理密码或令牌。
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_ADMIN_PASSWORD=demoGrafanaPasswordChangeBeforeUse
MYSQL_EXPORTER_PASSWORD=demoMetricsPasswordChangeBeforeUse
# alertsink 只保留历史独立调试入口，Compose 已由 doctor 接收告警。
ALERTSINK_ADDR=:8091
# 构建时写入 app_build_info 与启动日志；正式验收可使用阶段号或提交号。
APP_VERSION=20261026.1
# 默认采样十分之一；已有采样父节点时跟随父节点，单次验收可传 sampled traceparent。
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
