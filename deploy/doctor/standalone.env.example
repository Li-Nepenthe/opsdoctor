# 这里只放演示假值。复制为本目录的.env.standalone后填写，不覆盖已有配置。
# .env.standalone与.env.targets均被仓库.gitignore忽略，不能提交真实凭据。
DOCTOR_MYSQL_PASSWORD='demo-only-doctor-password'
DOCTOR_MYSQL_ROOT_PASSWORD='demo-only-root-password'
DOCTOR_ADMIN_EMAIL=operator@example.invalid
DOCTOR_ADMIN_PASSWORD='demo-only-login-password'
JWT_SECRET='demo-only-replace-with-random-at-least-32-bytes'

# 路径相对compose.yaml所在的deploy/doctor目录；也可填写绝对路径。
# 先准备这个独立目录，只放需要接入的YAML与其.profile.md；不要默认加载全部演示系统。
DOCTOR_TARGETS_DIR=./your-targets
# 此文件只写target配置引用的系统凭据，例如WAREHOUSE_ALERT_TOKEN等，不写医生/模型配置。
DOCTOR_TARGET_ENV_FILE=./.env.targets
DOCTOR_HTTP_PORT=8090
DOCTOR_BIND_ADDR=127.0.0.1

# 下列均可选。默认Mock不调用真实模型，不产生模型费用。
LLM_PROVIDER=mock
LLM_BUDGET_ACCOUNT=standalone
LLM_BUDGET_CURRENCY=USD
LLM_TOTAL_BUDGET=10
LLM_DIAGNOSIS_BUDGET=0.30
EVAL_COMPARISON_ENABLED=false

# 获得真实调用授权后，按实际供应商填写参数与单价；不是填入Key就自动切换。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_FORMAT=responses
# LLM_MODEL=gpt-6.1-terra
# LLM_API_KEY=demo-only-not-a-real-key
# LLM_TIMEOUT=60s
# LLM_INPUT_PRICE_PER_MTOKEN=1
# LLM_OUTPUT_PRICE_PER_MTOKEN=5
# LLM_CACHE_HIT_PRICE_PER_MTOKEN=0.05
# LLM_CACHE_WRITE_PRICE_PER_MTOKEN=1.25
# 对比模型、调度、Cookie及手册路径的可选变量见compose.yaml和本目录README。
