      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"shop\"}",
          "legendFormat": "{{service}} {{route}} {{method}} {{result}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "库存熔断状态：0 关闭 / 1 半开 / 2 打开",
