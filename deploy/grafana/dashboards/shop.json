        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(rpc_client_retries_total[1m]))",
          "legendFormat": "{{service}} {{route}} {{method}} {{result}} {{__name__}}"
        }
